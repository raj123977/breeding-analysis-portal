import numpy as np
import pandas as pd

np.random.seed(42)

lines = [f"LINE_{i:02d}" for i in range(1, 11)]
testers = [f"TESTER_{j:02d}" for j in range(1, 5)]
locations = ["LOC_A", "LOC_B", "LOC_C"]
replications = [1, 2]
n_markers = 15

records = []
for loc in locations:
  for rep in replications:
    for line in lines:
      for tester in testers:
        yield_val = np.round(
            5.0
            + np.random.normal(0.5, 0.2)  # Line effect
            + np.random.normal(0.3, 0.15)  # Tester effect
            + np.random.normal(0.0, 0.4),  # Interaction + Error
            2,
        )
        height_val = np.round(85.0 + np.random.normal(0, 5), 1)

        row = {
            "Line": line,
            "Tester": tester,
            "Location_Env": loc,
            "Replication": rep,
            "Trait_Yield": yield_val,
            "Trait_Height": height_val,
        }

        # Add SNP markers (-1, 0, 1)
        for m in range(1, n_markers + 1):
          row[f"M_SNP{m:02d}"] = np.random.choice([-1, 0, 1])

        records.append(row)

df = pd.DataFrame(records)
df.to_excel("line_x_tester_multiloc_sample.xlsx", index=False)
print("File 'line_x_tester_multiloc_sample.xlsx' generated successfully.")